{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialChanged Event Payload",
  "type": "object",
  "properties": {
    "uid": {
      "type": "string"
    },
    "residentId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED",
        "LOST"
      ]
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "uid",
    "residentId",
    "status",
    "source"
  ],
  "additionalProperties": true
}
