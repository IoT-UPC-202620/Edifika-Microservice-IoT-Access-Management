{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AccessModeChanged Event Payload",
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "integer"
    },
    "deviceCode": {
      "type": "string"
    },
    "from": {
      "type": "string",
      "enum": [
        "FREE_ACCESS",
        "RESERVED"
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "FREE_ACCESS",
        "RESERVED"
      ]
    },
    "reservationId": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "deviceId",
    "deviceCode",
    "from",
    "to",
    "reservationId"
  ],
  "additionalProperties": true
}
