{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommandResult Event Payload",
  "type": "object",
  "properties": {
    "deviceId": {
      "type": "string"
    },
    "commandId": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "OK",
        "FAILED",
        "TIMEOUT",
        "EXPIRED",
        "ACKED"
      ]
    },
    "detail": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "deviceId",
    "commandId",
    "type",
    "status",
    "detail"
  ],
  "additionalProperties": true
}
