{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TelemetryAlertResource",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "deviceCode": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "kind": {
      "type": "string"
    },
    "state": {
      "type": "string",
      "enum": [
        "RAISED",
        "CLEARED"
      ]
    },
    "details": {
      "type": "object"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "deviceCode",
    "kind",
    "state",
    "details",
    "occurredAt"
  ],
  "additionalProperties": false
}
