{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GatewayCredentialsResource",
  "type": "object",
  "properties": {
    "gatewayId": {
      "type": "integer"
    },
    "gatewayCode": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "apiKey": {
      "type": "string"
    }
  },
  "required": [
    "gatewayId",
    "gatewayCode",
    "apiKey"
  ],
  "additionalProperties": false
}
