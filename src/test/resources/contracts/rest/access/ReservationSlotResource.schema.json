{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReservationSlotResource",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "startsAt": {
      "type": "string",
      "format": "date-time"
    },
    "endsAt": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "SCHEDULED",
        "ACTIVE",
        "ENDED",
        "CANCELLED"
      ]
    },
    "mine": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "startsAt",
    "endsAt",
    "status",
    "mine"
  ],
  "additionalProperties": false
}
