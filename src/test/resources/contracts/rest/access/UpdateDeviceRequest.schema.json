{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UpdateDeviceRequest",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "RFID",
          "LOCK",
          "BUZZER",
          "OLED",
          "RGB_LED",
          "TEMPERATURE",
          "HUMIDITY"
        ]
      }
    },
    "unlockSeconds": {
      "type": "integer"
    }
  },
  "additionalProperties": false
}
