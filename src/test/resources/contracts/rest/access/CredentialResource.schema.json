{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialResource",
  "type": "object",
  "properties": {
    "id": {
      "type": "integer"
    },
    "rfidUid": {
      "type": "string"
    },
    "buildingId": {
      "type": "integer"
    },
    "userId": {
      "type": [
        "integer",
        "null"
      ]
    },
    "holderName": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED",
        "REVOKED",
        "LOST"
      ]
    },
    "suspensionReason": {
      "type": [
        "string",
        "null"
      ]
    },
    "validFrom": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "validUntil": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "origin": {
      "type": "string",
      "enum": [
        "CLOUD",
        "EDGE"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "id",
    "rfidUid",
    "buildingId",
    "userId",
    "holderName",
    "status",
    "suspensionReason",
    "validFrom",
    "validUntil",
    "origin",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
