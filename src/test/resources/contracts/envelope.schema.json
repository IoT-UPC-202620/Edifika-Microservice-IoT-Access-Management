{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AMQP Integration Envelope",
  "type": "object",
  "properties": {
    "eventId": {
      "type": "string",
      "pattern": "^[a-f0-9]{32}$|^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "eventType": {
      "type": "string"
    },
    "eventVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "producer": {
      "type": "string",
      "enum": [
        "edge-gateway",
        "iot-access-management",
        "iot-telemetry"
      ]
    },
    "buildingId": {
      "type": [
        "integer",
        "null"
      ]
    },
    "gatewayCode": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9-]{3,64}$"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "buildingId",
    "gatewayCode",
    "correlationId",
    "payload"
  ],
  "additionalProperties": true
}
